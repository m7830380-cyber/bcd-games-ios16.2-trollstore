+    info.length = placed ? map_size : block_size;
     block.buffer = device_.newBuffer(info);
+    if (placed && !block.buffer) {
+      static bool warned;
+      if (!warned) {
+        warned = true;
+        WARN("[ring-align] madeira ios16: Metal refused a ", map_size,
+             "-byte page-aligned block; such blocks are allocated by Metal instead");
+      }
+      wsi::aligned_free(block.mapped_address);
+      info.memory.set(nullptr);
+      info.length = block_size;
+      block.buffer = device_.newBuffer(info);
+      /* the unix side hands back [buffer contents] */
+      block.mapped_address = info.memory.get_accessible_or_null();
+      block.owns_mapping = false;
+    }
     block.gpu_address = info.gpu_address;
     block.census_bytes = block_size;                       /* ml677 */
     block.census_owner = census_owner_;
