-    block.mapped_address = placed ? malloc(block_size) : nullptr;
+    /* Madeira iOS 16: newBufferWithBytesNoCopy only wraps memory that starts
+     * on a 16 KB page and spans whole pages. A plain malloc of a block (the
+     * Windows heap: a header sits in front of every large block) never does,
+     * so Metal returned nil for every argument-buffer block: each encoder
+     * bound a nil buffer at vertex/fragment 16, 29 and 30, every shader read
+     * zeroed vertex and constant tables, and every pass drew nothing -- the
+     * all-zero frame ([ftrace] vbtable=0x0). Private storage cannot wrap CPU
+     * memory at all. If Metal still refuses, it allocates the block itself
+     * and the CPU side writes through [buffer contents]. */
+    constexpr size_t kMetalPage = 16384;
+    if (((uint64_t)buffer_info_ & 0x30) == (uint64_t)WMTResourceStorageModePrivate)
+      placed = false;
+    const size_t map_size = (block_size + kMetalPage - 1) & ~(kMetalPage - 1);
+    block.mapped_address = placed ? wsi::aligned_malloc(map_size, kMetalPage) : nullptr;
