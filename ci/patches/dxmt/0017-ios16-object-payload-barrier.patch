diff --git a/src/airconv/dxbc_converter_gs.cpp b/src/airconv/dxbc_converter_gs.cpp
index 6c152a1..f29d63b 100644
--- a/src/airconv/dxbc_converter_gs.cpp
+++ b/src/airconv/dxbc_converter_gs.cpp
@@ -683,6 +683,9 @@ convert_dxbc_vertex_for_geometry_shader(
 
   // explicit initialization
   air.CreateAtomicRMW(llvm::AtomicRMWInst::BinOp::And, valid_vertex_mask, builder.getInt32(0));
+  /* Madeira iOS 16: every thread clears the mask; make sure all of them have
+   * before any sets its bit, or a late clear drops valid primitives. */
+  air.CreateBarrier(llvm::air::MemFlags::Threadgroup);
 
   builder.CreateCondBr(
       builder.CreateICmp(llvm::CmpInst::ICMP_ULT, global_index_id, vertex_count), index_check, will_dispatch
@@ -748,7 +751,12 @@ convert_dxbc_vertex_for_geometry_shader(
 
   builder.SetInsertPoint(will_dispatch);
 
-  air.CreateBarrier(llvm::air::MemFlags::Threadgroup);
+  /* Madeira iOS 16: the vertex outputs above go to the object payload
+   * (object_data memory), which a threadgroup-only barrier does not order. On
+   * iOS 16 the mesh stage then read half-written payloads: UE4's colour LUT,
+   * filled through this path, came out as random triangles, different every
+   * frame ([ftrace] pass SLICE readback), and Brick Rigs looked inverted. */
+  air.CreateBarrier(llvm::air::MemFlags((int)llvm::air::MemFlags::Threadgroup | (int)llvm::air::MemFlags::ObjectData));
 
   builder.CreateCondBr(
       builder.CreateICmp(llvm::CmpInst::ICMP_EQ, warp_vertex_id, builder.getInt32(0)), dispatch, return_
diff --git a/src/airconv/dxbc_converter_ts.cpp b/src/airconv/dxbc_converter_ts.cpp
