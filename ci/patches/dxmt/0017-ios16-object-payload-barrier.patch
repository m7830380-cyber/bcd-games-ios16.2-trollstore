+  air.CreateBarrier(llvm::air::MemFlags((int)llvm::air::MemFlags::Threadgroup | (int)llvm::air::MemFlags::ObjectData));
   builder.CreateRetVoid();
 
   module.getOrInsertNamedMetadata("air.object")->addOperand(function_metadata);
