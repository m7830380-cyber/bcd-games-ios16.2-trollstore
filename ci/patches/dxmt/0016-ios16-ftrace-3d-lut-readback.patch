+/* Writes rgb (clamped 0..1, gamma 1/2.2 for HDR formats) as a binary PPM in Documents. */
+static void ft_save_ppm(const char *name, NSUInteger w, NSUInteger h, const float *rgb, int hdr) {
+  NSString *docs = NSSearchPathForDirectoriesInDomains(NSDocumentDirectory, NSUserDomainMask, YES).firstObject;
+  if (!docs) return;
+  NSString *path = [docs stringByAppendingPathComponent:[NSString stringWithUTF8String:name]];
+  FILE *f = fopen(path.fileSystemRepresentation, "wb");
+  if (!f) return;
+  fprintf(f, "P6\n%lu %lu\n255\n", (unsigned long)w, (unsigned long)h);
+  for (NSUInteger i = 0; i < w * h * 3; i++) {
+    float v = rgb[i];
+    if (hdr) v = v / (1.0f + v);          /* Reinhard, so HDR scene colour stays readable */
+    v = v < 0 ? 0 : v > 1 ? 1 : v;
+    if (hdr) v = powf(v, 1.0f / 2.2f);
+    fputc((int)(v * 255.0f + 0.5f), f);
+  }
+  fclose(f);
+  fprintf(stderr, "[ftrace] saved %s\n", path.fileSystemRepresentation);
+}
