+/* RG11B10Float: 6-bit mantissa + 5-bit exponent (R, G), 5 + 5 (B), no sign. */
+static float ft_uf(uint32_t v, int mbits) {
+  uint32_t m = v & ((1u << mbits) - 1), e = v >> mbits;
+  if (e == 0) return ldexpf((float)m, -14 - mbits);
+  if (e == 31) return 65504.0f;
+  return ldexpf(1.0f + (float)m / (float)(1u << mbits), (int)e - 15);
+}
+
+static void ft_decode(const uint8_t *p, int kind, int ch, MTLPixelFormat fmt, float c[4]) {
+  c[0] = c[1] = c[2] = c[3] = 0;
+  for (int k = 0; k < ch; k++) {
+    if (kind == 0) c[k] = p[k] / 255.f;
+    else if (kind == 1) c[k] = ft_half(((const uint16_t *)p)[k]);
+    else if (kind == 2) c[k] = ((const float *)p)[k];
+  }
+  if (kind == 3) {
+    uint32_t v = *(const uint32_t *)p;
+    c[0] = (v & 1023) / 1023.f; c[1] = ((v >> 10) & 1023) / 1023.f; c[2] = ((v >> 20) & 1023) / 1023.f; c[3] = (v >> 30) / 3.f;
+  } else if (kind == 4) {
+    uint32_t v = *(const uint32_t *)p;
+    c[0] = ft_uf(v & 2047, 6); c[1] = ft_uf((v >> 11) & 2047, 6); c[2] = ft_uf(v >> 22, 5); c[3] = 1;
+  }
+  if (fmt == MTLPixelFormatBGRA8Unorm || fmt == MTLPixelFormatBGRA8Unorm_sRGB || fmt == MTLPixelFormatBGR10A2Unorm) {
+    float x = c[0]; c[0] = c[2]; c[2] = x;
+  }
+  for (int k = 0; k < 4; k++)
+    if (c[k] != c[k]) c[k] = 0;
+}
