+/* Madeira iOS 16: one-shot probe, started by the first render PSO the game
+ * asks for. iOS 16's AGX compiler names nothing ("Compiler encountered an
+ * internal error"), even for a full-screen blit, so on a background queue
+ * this hands the compiler, all at once, the tests of pso_probe_data.h:
+ * DXMT's own Apple-built vs/fs_blit_quad (raw and re-encoded by LLVM 15/14),
+ * airconv's skeleton and People Playground's failing blit shaders, each with
+ * one change, and logs every answer as [pso-probe] with its time.
+ * On by default below iOS 17; MADEIRA_PSO_PROBE=0 turns it off, =1 forces it. */
+#include "pso_probe_data.h"
+#include <dispatch/dispatch.h>
+#include <sys/sysctl.h>
+#include <unistd.h>
+#include <time.h>
+
+static double
+wmt_pso_probe_ms(const struct timespec *t0) {
+  struct timespec t1;
+  clock_gettime(CLOCK_MONOTONIC, &t1);
+  return (t1.tv_sec - t0->tv_sec) * 1e3 + (t1.tv_nsec - t0->tv_nsec) / 1e6;
+}
+
+static id<MTLFunction>
+wmt_pso_probe_fn(id<MTLDevice> device, const unsigned char *bytes, unsigned size, const char *fn, const char *what) {
+  dispatch_data_t data = dispatch_data_create(bytes, size, NULL, DISPATCH_DATA_DESTRUCTOR_DEFAULT);
+  NSError *le = NULL;
+  id<MTLLibrary> lib = [device newLibraryWithData:data error:&le];
+  dispatch_release(data);
+  id<MTLFunction> f = lib ? [lib newFunctionWithName:[NSString stringWithUTF8String:fn]] : nil;
+  if (!f)
+    fprintf(stderr, "[pso-probe] %-24s NOLIB %s\n", what, le ? [[le localizedDescription] UTF8String] : "(no function)");
+  [lib release];
+  return f;
+}
+
+static atomic_int wmt_pso_probe_answered;
+
+/* asynchronous, so the compiler service gets every test at once */
+static void
+wmt_pso_probe_submit(id<MTLDevice> device, MTLPixelFormat fmt, id<MTLFunction> vs, id<MTLFunction> fs,
+                     const char *what, dispatch_group_t group) {
+  if (!vs)
+    return;
+  MTLRenderPipelineDescriptor *m = [[MTLRenderPipelineDescriptor alloc] init];
+  m.colorAttachments[0].pixelFormat = fmt;
+  m.vertexFunction = vs;
+  m.fragmentFunction = fs;
+  char *name = strdup(what);
+  struct timespec t0;
+  clock_gettime(CLOCK_MONOTONIC, &t0);
+  dispatch_group_enter(group);
+  [device newRenderPipelineStateWithDescriptor:m
+                             completionHandler:^(id<MTLRenderPipelineState> pso, NSError *e) {
+                               fprintf(stderr, "[pso-probe] %-24s %s (%.0f ms)%s%s\n", name, pso ? "OK  " : "FAIL",
+                                       wmt_pso_probe_ms(&t0), pso ? "" : " ",
+                                       pso ? "" : (e ? [[e localizedDescription] UTF8String] : "(no error)"));
+                               free(name);
+                               atomic_fetch_add(&wmt_pso_probe_answered, 1);
+                               dispatch_group_leave(group);
+                             }];
+  [m release];
+}
+
+static int
+wmt_pso_probe_wanted(void) {
+  const char *env = getenv("MADEIRA_PSO_PROBE");
+  if (env && *env)
+    return *env != '0';
+  char v[32] = {0};
+  size_t n = sizeof(v) - 1;
+  int major = sysctlbyname("kern.osproductversion", v, &n, NULL, 0) == 0 ? atoi(v) : 0;
+  return major > 0 && major < 17;
+}
+
+/* The game's own compiles share the one AGX compiler service with the probe;
+ * on iOS 16.2 each of its failing pipelines takes 15-25 s. While the probe
+ * runs, game compiles wait here (at most 5 min); they fail anyway. */
+static atomic_int wmt_pso_probe_busy;
+
+static void
+wmt_pso_probe_gate(void) {
+  if (!atomic_load(&wmt_pso_probe_busy))
+    return;
+  for (int i = 0; i < 3000 && atomic_load(&wmt_pso_probe_busy); i++)
+    usleep(100000);
+}
+
+static void
+wmt_pso_probe(id<MTLDevice> device, MTLRenderPipelineDescriptor *first) {
+  static atomic_int done;
+  if (atomic_fetch_add(&done, 1) || !device || !wmt_pso_probe_wanted())
+    return;
+  atomic_store(&wmt_pso_probe_busy, 1);
+  MTLPixelFormat fmt = first.colorAttachments[0].pixelFormat;
+  if (fmt == MTLPixelFormatInvalid)
+    fmt = MTLPixelFormatBGRA8Unorm;
+  const unsigned n = sizeof(pso_probe_tests) / sizeof(pso_probe_tests[0]);
+  fprintf(stderr, "[pso-probe] begin: %u tests, all at once; the game waits for them. Keep the app open "
+                  "until [pso-probe] end (up to ~5 min). rt0=%lu\n", n, (unsigned long)fmt);
+  [device retain];
+  dispatch_async(dispatch_get_global_queue(QOS_CLASS_USER_INITIATED, 0), ^{
+    @autoreleasepool {
+      struct timespec t0;
+      clock_gettime(CLOCK_MONOTONIC, &t0);
+      NSError *e = NULL;
+      id<MTLLibrary> basic = [device newLibraryWithSource:@
+        "#include <metal_stdlib>\n"
+        "using namespace metal;\n"
+        "struct O { float4 p [[position]]; };\n"
+        "struct OT { float4 p [[position]]; float4 t [[user(texcoord0)]]; };\n"
+        "vertex O v_plain(uint vid [[vertex_id]]) { O o; o.p = float4(float(vid & 1), float(vid >> 1), 0, 1); return o; }\n"
+        "vertex OT v_tc(uint vid [[vertex_id]]) {\n"
+        "  OT o; o.p = float4(float(vid & 1), float(vid >> 1), 0, 1); o.t = float4(o.p.xy, 0, 0); return o; }\n"
+        "fragment float4 f_zero() { return float4(0); }\n"
+                                                    options:nil error:&e];
+      if (!basic)
+        fprintf(stderr, "[pso-probe] MSL library FAIL %s\n", e ? [[e localizedDescription] UTF8String] : "");
+      id<MTLFunction> v_plain = [basic newFunctionWithName:@"v_plain"];
+      id<MTLFunction> v_tc = [basic newFunctionWithName:@"v_tc"];
+      id<MTLFunction> f_zero = [basic newFunctionWithName:@"f_zero"];
+      dispatch_group_t group = dispatch_group_create();
+      wmt_pso_probe_submit(device, fmt, v_plain, f_zero, "MSL v_plain + f_zero", group);
+      unsigned sent = 1;
+      for (unsigned i = 0; i < n; i++) {
+        const char *what = pso_probe_tests[i].name;
+        id<MTLFunction> vs = pso_probe_tests[i].vs
+            ? wmt_pso_probe_fn(device, pso_probe_tests[i].vs, pso_probe_tests[i].vs_size, pso_probe_tests[i].vs_fn, what)
+            : [v_tc retain];
+        id<MTLFunction> fs = pso_probe_tests[i].fs
+            ? wmt_pso_probe_fn(device, pso_probe_tests[i].fs, pso_probe_tests[i].fs_size, pso_probe_tests[i].fs_fn, what)
+            : nil;
+        if (vs && (fs || !pso_probe_tests[i].fs)) {
+          wmt_pso_probe_submit(device, fmt, vs, fs, what, group);
+          sent++;
+        }
+        [vs release];
+        [fs release];
+      }
+      fprintf(stderr, "[pso-probe] %u pipelines handed to the compiler (%.0f ms)\n", sent, wmt_pso_probe_ms(&t0));
+      long timed_out = dispatch_group_wait(group, dispatch_time(DISPATCH_TIME_NOW, 300ll * NSEC_PER_SEC));
+      fprintf(stderr, "[pso-probe] end: %d of %u answered in %.0f ms%s\n", atomic_load(&wmt_pso_probe_answered), sent,
+              wmt_pso_probe_ms(&t0), timed_out ? " (gave up waiting for the rest)" : "");
+      if (!timed_out)
+        dispatch_release(group); /* else answers may still come in: keep it */
+      [v_plain release]; [v_tc release]; [f_zero release]; [basic release];
+      if (!timed_out)
+        [device release];
+      atomic_store(&wmt_pso_probe_busy, 0);
+    }
+  });
+}
