+/* Madeira iOS 16: one-shot probe after the first render PSO that fails to
+ * compile. iOS 16's AGX compiler names nothing ("Compiler encountered an
+ * internal error"), even for a full-screen blit, so on a background queue this
+ * compiles, each logged as [pso-probe] with its time:
+ *  1. runtime-compiled MSL pipelines (does the compiler work at all; the
+ *     same blit written in MSL),
+ *  2. variants of People Playground's failing blit VS, one change each
+ *     (pso_probe_data.h), vertex-only,
+ *  3. variants of its failing PS behind an MSL VS,
+ *  4. the failing pipeline's own VS alone and its FS behind an MSL VS.
+ * On by default below iOS 17; MADEIRA_PSO_PROBE=0 turns it off, =1 forces it. */
+#include "pso_probe_data.h"
+#include <dispatch/dispatch.h>
+#include <sys/sysctl.h>
+#include <time.h>
+
+static int
+wmt_pso_probe_try(id<MTLDevice> device, MTLRenderPipelineDescriptor *d, const char *what) {
+  NSError *e = NULL;
+  struct timespec t0, t1;
+  clock_gettime(CLOCK_MONOTONIC, &t0);
+  id<MTLRenderPipelineState> pso = [device newRenderPipelineStateWithDescriptor:d error:&e];
+  clock_gettime(CLOCK_MONOTONIC, &t1);
+  double ms = (t1.tv_sec - t0.tv_sec) * 1e3 + (t1.tv_nsec - t0.tv_nsec) / 1e6;
+  fprintf(stderr, "[pso-probe] %-28s %s (%.0f ms)%s%s\n", what, pso ? "OK  " : "FAIL", ms, pso ? "" : " ",
+          pso ? "" : (e ? [[e localizedDescription] UTF8String] : "(no error)"));
+  if (pso)
+    [pso release];
+  return pso != nil;
+}
+
+static id<MTLFunction>
+wmt_pso_probe_fn(id<MTLDevice> device, const unsigned char *bytes, unsigned size, const char *fn, const char *what) {
+  dispatch_data_t data = dispatch_data_create(bytes, size, NULL, DISPATCH_DATA_DESTRUCTOR_DEFAULT);
+  NSError *le = NULL;
+  id<MTLLibrary> lib = [device newLibraryWithData:data error:&le];
+  dispatch_release(data);
+  id<MTLFunction> f = lib ? [lib newFunctionWithName:[NSString stringWithUTF8String:fn]] : nil;
+  if (!f)
+    fprintf(stderr, "[pso-probe] %-28s NOLIB %s\n", what, le ? [[le localizedDescription] UTF8String] : "(no function)");
+  [lib release];
+  return f;
+}
+
+static id<MTLLibrary>
+wmt_pso_probe_msl(id<MTLDevice> device, NSString *src, const char *what) {
+  NSError *e = NULL;
+  id<MTLLibrary> lib = [device newLibraryWithSource:src options:nil error:&e];
+  fprintf(stderr, "[pso-probe] MSL library %-16s %s %s\n", what, lib ? "OK  " : "FAIL",
+          lib ? "" : (e ? [[e localizedDescription] UTF8String] : ""));
+  return lib;
+}
+
+static void
+wmt_pso_probe_pair(id<MTLDevice> device, MTLPixelFormat fmt, id<MTLFunction> vs, id<MTLFunction> fs, const char *what) {
+  if (!vs)
+    return;
+  MTLRenderPipelineDescriptor *m = [[MTLRenderPipelineDescriptor alloc] init];
+  m.colorAttachments[0].pixelFormat = fmt;
+  m.vertexFunction = vs;
+  m.fragmentFunction = fs;
+  wmt_pso_probe_try(device, m, what);
+  [m release];
+}
+
+static int
+wmt_pso_probe_wanted(void) {
+  const char *env = getenv("MADEIRA_PSO_PROBE");
+  if (env && *env)
+    return *env != '0';
+  char v[32] = {0};
+  size_t n = sizeof(v) - 1;
+  int major = sysctlbyname("kern.osproductversion", v, &n, NULL, 0) == 0 ? atoi(v) : 0;
+  return major > 0 && major < 17;
+}
+
+static void
+wmt_pso_probe(id<MTLDevice> device, MTLRenderPipelineDescriptor *failed) {
+  static atomic_int done;
+  if (atomic_fetch_add(&done, 1) || !device || !wmt_pso_probe_wanted())
+    return;
+  MTLPixelFormat fmt = failed.colorAttachments[0].pixelFormat;
+  if (fmt == MTLPixelFormatInvalid)
+    fmt = MTLPixelFormatBGRA8Unorm;
+  fprintf(stderr, "[pso-probe] begin (background, a failing compile can take ~30 s; wait for [pso-probe] end): "
+                  "vs=%s fs=%s rt0=%lu\n",
+          failed.vertexFunction ? [failed.vertexFunction.name UTF8String] : "-",
+          failed.fragmentFunction ? [failed.fragmentFunction.name UTF8String] : "-", (unsigned long)fmt);
+  id<MTLFunction> failed_vs = [failed.vertexFunction retain];
+  id<MTLFunction> failed_fs = [failed.fragmentFunction retain];
+  [device retain];
+  dispatch_async(dispatch_get_global_queue(QOS_CLASS_UTILITY, 0), ^{
+    @autoreleasepool {
+      id<MTLLibrary> basic = wmt_pso_probe_msl(device, @
+        "#include <metal_stdlib>\n"
+        "using namespace metal;\n"
+        "struct O { float4 p [[position]]; };\n"
+        "struct OT { float4 p [[position]]; float4 t [[user(texcoord0)]]; };\n"
+        "vertex O v_plain(uint vid [[vertex_id]]) { O o; o.p = float4(float(vid & 1), float(vid >> 1), 0, 1); return o; }\n"
+        "vertex OT v_tc(uint vid [[vertex_id]]) {\n"
+        "  OT o; o.p = float4(float(vid & 1), float(vid >> 1), 0, 1); o.t = float4(o.p.xy, 0, 0); return o; }\n"
+        "fragment float4 f_zero() { return float4(0); }\n", "basic");
+      id<MTLLibrary> blit = wmt_pso_probe_msl(device, @
+        "#include <metal_stdlib>\n"
+        "using namespace metal;\n"
+        "struct OT { float4 p [[position]]; float4 t [[user(texcoord0)]]; };\n"
+        "struct VB { device uchar *p; uint stride; uint len; };\n"
+        "struct CB { constant float4 *cb0; };\n"
+        "struct TB { sampler s0; sampler cs0; ulong ms; texture2d<float> t0; ulong mt; };\n"
+        "vertex OT v_blit(uint vid [[vertex_id]], uint bv [[base_vertex]], uint iid [[instance_id]],\n"
+        "                 uint bi [[base_instance]], constant VB *vb [[buffer(16)]], constant CB &cb [[buffer(29)]]) {\n"
+        "  device uchar *q = vb[0].p + vid * vb[0].stride; OT o;\n"
+        "  float3 p = float3(*(device packed_float3 *)q); float2 uv = float2(*(device packed_float2 *)(q + 12));\n"
+        "  o.p = float4(fma(p.xy, float2(2.0f), float2(-1.0f)), 0, 1); o.t = float4(fma(fma(uv, float2(1, -1), float2(0, 1)), cb.cb0[0].xy,\n"
+        "                                                            cb.cb0[0].zw), 0, 0);\n"
+        "  return o; }\n"
+        "fragment float4 f_tex(OT i [[stage_in]], constant TB &tb [[buffer(30)]]) { return tb.t0.sample(tb.s0, i.t.xy); }\n",
+        "blit");
+      id<MTLFunction> v_plain = [basic newFunctionWithName:@"v_plain"];
+      id<MTLFunction> v_tc = [basic newFunctionWithName:@"v_tc"];
+      id<MTLFunction> f_zero = [basic newFunctionWithName:@"f_zero"];
+      id<MTLFunction> v_blit = [blit newFunctionWithName:@"v_blit"];
+      id<MTLFunction> f_tex = [blit newFunctionWithName:@"f_tex"];
+      wmt_pso_probe_pair(device, fmt, v_plain, f_zero, "MSL v_plain + f_zero");
+      wmt_pso_probe_pair(device, fmt, v_plain, nil, "MSL v_plain alone");
+      wmt_pso_probe_pair(device, fmt, v_blit, nil, "MSL v_blit alone");
+      wmt_pso_probe_pair(device, fmt, v_tc, f_tex, "MSL v_tc + f_tex");
+      for (unsigned i = 0; i < sizeof(pso_probe_vs) / sizeof(pso_probe_vs[0]); i++) {
+        char what[64];
+        snprintf(what, sizeof what, "airconv VS %s", pso_probe_vs[i].name);
+        id<MTLFunction> f = wmt_pso_probe_fn(device, pso_probe_vs[i].data, pso_probe_vs[i].size, pso_probe_vs_function, what);
+        wmt_pso_probe_pair(device, fmt, f, nil, what);
+        [f release];
+      }
+      for (unsigned i = 0; i < sizeof(pso_probe_ps) / sizeof(pso_probe_ps[0]); i++) {
+        char what[64];
+        snprintf(what, sizeof what, "MSL v_tc + airconv PS %s", pso_probe_ps[i].name);
+        id<MTLFunction> f = wmt_pso_probe_fn(device, pso_probe_ps[i].data, pso_probe_ps[i].size, pso_probe_ps_function, what);
+        if (f)
+          wmt_pso_probe_pair(device, fmt, v_tc, f, what);
+        [f release];
+      }
+      wmt_pso_probe_pair(device, fmt, failed_vs, nil, "game's failed VS alone");
+      if (failed_fs)
+        wmt_pso_probe_pair(device, fmt, v_tc, failed_fs, "MSL v_tc + game's failed FS");
+      [v_plain release]; [v_tc release]; [f_zero release]; [v_blit release]; [f_tex release];
+      [basic release]; [blit release];
+      [failed_vs release]; [failed_fs release];
+      [device release];
+      fprintf(stderr, "[pso-probe] end\n");
+    }
+  });
+}
