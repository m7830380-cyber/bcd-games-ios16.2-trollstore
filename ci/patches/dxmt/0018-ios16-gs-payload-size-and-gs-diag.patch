@@ -101,6 +101,17 @@ struct MTL_GEOMETRY_SHADER_PASS_THROUGH {
   uint8_t ViewportArrayIndexComponent;
 };
 
+/* Madeira iOS 16: bytes of object payload the GS emulation needs: a 16-byte
+ * header plus one VS output record per object thread (at most 32). It used to
+ * always reserve the 16256-byte maximum; on iOS 16.2 (A16) the mesh stage then
+ * read corrupted vertices (UE4 colour LUT and translucency volume drawn as
+ * wrong wedges, Brick Rigs colours wrong). Object shader, mesh shader and the
+ * pipeline descriptor must all use this same value. */
+static inline uint32_t MTLGSPayloadSize(uint32_t vs_output_registers) {
+  uint64_t size = 16 + 32ull * 16ull * vs_output_registers;
+  return size > 16256 ? 16256u : (uint32_t)size;
+}
+
 struct MTL_GEOMETRY_SHADER_REFLECTION {
   union {
     struct MTL_GEOMETRY_SHADER_PASS_THROUGH Data;
