diff --git a/src/airconv/dxbc_converter.cpp b/src/airconv/dxbc_converter.cpp
index 35222b8..65657a2 100644
--- a/src/airconv/dxbc_converter.cpp
+++ b/src/airconv/dxbc_converter.cpp
@@ -966,9 +966,15 @@ llvm::Error convertDXBC(
 bool CheckGSBBIsPassThrough(dxmt::dxbc::BasicBlock *bb) {
   using namespace dxmt::dxbc;
   if (bb->instructions.any(patterns{
-        [](InstNop &) { return false; }, [](InstMov &mov) { return false; },
-        [](InstEmit &) { return false; }, [](InstCut &) { return false; },
-        [](auto &) { return true; }
+        /* Madeira iOS 16: InstructionList::any() hands the visitor const
+         * references, so the old non-const overloads never matched and every
+         * instruction fell to the generic case: no GS was ever pass-through.
+         * UE4's WriteToSlice GS (Brick Rigs colour LUT, translucency volume)
+         * then went through the mesh-shader emulation, which draws it wrong on
+         * iOS 16. */
+        [](const InstNop &) { return false; }, [](const InstMov &) { return false; },
+        [](const InstEmit &) { return false; }, [](const InstCut &) { return false; },
+        [](const auto &) { return true; }
       }))
     return false;
 
