   if (err && !params->ret_pso)   /* Madeira iOS 16: [pso-probe] */
     wmt_pso_probe((id<MTLDevice>)params->device, descriptor);
   params->ret_error = (obj_handle_t)err;
@@ -2389,6 +2513,11 @@ _MTLDevice_newRenderPipelineStateVD(void *obj) {
     if (madeira_arch && params->ret_pso && !err) madeira_arch_add(descriptor, 0);
   }
   [madeira_arch release];
+  if (err && !params->ret_pso) {   /* Madeira iOS 16: [pso-mut] */
+    params->ret_pso = wmt_pso_mut_render((id<MTLDevice>)params->device, descriptor, options, err);
+    if (params->ret_pso)
+      err = NULL;
+  }
   if (err && !params->ret_pso)   /* Madeira iOS 16: [pso-probe] */
     wmt_pso_probe((id<MTLDevice>)params->device, descriptor);
   params->ret_error = (obj_handle_t)err;
