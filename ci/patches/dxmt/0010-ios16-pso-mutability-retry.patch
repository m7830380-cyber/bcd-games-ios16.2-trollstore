   struct unixcall_mtldevice_newcomputepso *params = obj;
@@ -1807,6 +1921,11 @@ _MTLDevice_newComputePipelineState(void *obj) {
     if (madeira_arch && params->ret_pso && !err) madeira_arch_add(descriptor, 1);
